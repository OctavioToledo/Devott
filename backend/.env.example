# Copiá este archivo a .env y completá los valores. El .env no se sube al repo.

SERVER_PORT=8080

# Base de datos local (ver infra/.env.example). Se usa a partir del paso 1.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/devott
SPRING_DATASOURCE_USERNAME=devott
SPRING_DATASOURCE_PASSWORD=devott

# Supabase Auth: el backend valida los JWT emitidos por este proyecto con sus claves públicas (JWKS).
# El proyecto tiene que usar claves de firma asimétricas (Settings > JWT Keys), no el secreto HS256 heredado.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_JWT_ISSUER=https://<tu-proyecto>.supabase.co/auth/v1

# Origen del frontend permitido por CORS.
FRONTEND_URL=http://localhost:3000

# URL pública de esta API (se usa para las URLs del almacenamiento local).
API_URL=http://localhost:8080

# Almacenamiento de fotos y logos: "local" (directorio del backend, para desarrollo) o "supabase".
ALMACENAMIENTO=local
ALMACENAMIENTO_LOCAL_DIR=./almacenamiento-local

# Con ALMACENAMIENTO=supabase: bucket público y clave secreta del proyecto (sb_secret_...).
# La clave secreta nunca va al frontend.
SUPABASE_BUCKET=fotos
SUPABASE_SECRET_KEY=

# Cotización del dólar (dolarapi.com) para el precio de referencia de publicaciones en pesos.
# DEVOTT_COTIZACIONES_CRON=0 0 */3 * * *
# DEVOTT_COTIZACIONES_AL_INICIAR=true

# Emails con acceso a /admin (planes y suscripciones), separados por coma.
DEVOTT_ADMINS=
