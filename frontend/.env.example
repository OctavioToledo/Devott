# Copiá este archivo a .env.local y completá los valores. Los .env no se suben al repo.

# URL pública del sitio (metadatos Open Graph y links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL base de la API de Spring
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Supabase: solo para login y subida de fotos con URL firmada.
# Sin estos valores la app funciona igual, pero sin login.
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<tu-clave>
